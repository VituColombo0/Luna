# ============================================
# Alfred — Serviço systemd para auto-start
# ============================================
# Este arquivo configura o Alfred para iniciar automaticamente
# quando o computador liga.
#
# INSTALAÇÃO:
#   1. Edite o campo User e WorkingDirectory abaixo
#   2. Copie este arquivo:
#      sudo cp alfred.service /etc/systemd/system/
#   3. Habilite o serviço:
#      sudo systemctl enable alfred.service
#   4. Inicie agora (sem reiniciar):
#      sudo systemctl start alfred.service
#   5. Veja os logs:
#      journalctl -u alfred -f
#
# NOTA: Como o Alfred usa o terminal para interação,
#       este serviço é mais útil se você rodar o Alfred
#       em modo API/daemon. Para uso interativo, use
#       o autostart do seu desktop environment (veja abaixo).

[Unit]
Description=Alfred - Assistente Pessoal de IA
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=TROCAR_PELO_SEU_USUARIO
WorkingDirectory=/home/TROCAR_PELO_SEU_USUARIO/Alfred
ExecStartPre=/bin/bash -c 'pgrep ollama || ollama serve &'
ExecStartPre=/bin/sleep 3
ExecStart=/home/TROCAR_PELO_SEU_USUARIO/Alfred/venv/bin/python -m alfred
Restart=on-failure
RestartSec=10
Environment=HOME=/home/TROCAR_PELO_SEU_USUARIO
Environment=DISPLAY=:0
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native

[Install]
WantedBy=multi-user.target
